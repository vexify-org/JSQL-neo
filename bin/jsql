#!/usr/bin/env node
const path = require('path');
const fs = require('fs');
const yaggs = require('@vexify-org/yaggs');
const { ModuleManager } = require('../lib/mod');
const Database = require('../lib/database');
const migrate = require('../lib/migrate');
const { nag, setStarred, readConfig } = require('../lib/star-nag');

// star 提示：任何异常都不该挡住命令本身
// version / --version 只回版本号、star 本身就是干这件事的 —— 这些不提示，其余全部提示
const NO_NAG_ARGS = new Set(['version', '--version', '-v', 'star']);
if (!process.env.JSQL_NO_STAR_NAG && !NO_NAG_ARGS.has(process.argv[2])) {
  try { nag(); } catch (e) { /* 提示失败与命令无关 */ }
}

function printModules(list) {
  if (list.length === 0) {
    console.log('No modules registered.');
    return;
  }
  const rows = list.map(m =>
    `${m.enabled ? 'ON ' : 'OFF'}  ${m.name.padEnd(24)} ${m.path}`
  );
  console.log(rows.join('\n'));
}

const manager = new ModuleManager();

const RAW_ARGV = process.argv.slice(2);

const cli = yaggs({ pkg: require('../package.json') })
  .usage('jsql <command> [options]')
  .option('help', { alias: ['h'], type: 'boolean', description: 'Show help' })
  .command('mod', 'Module management', (sub) => {
    sub.option('address', {
      alias: ['a'],
      type: 'string',
      description: 'Path to module file'
    });
    sub.option('json', {
      type: 'boolean',
      description: 'Output as JSON'
    });
  }, (argv) => {
    const action = argv._[0];
    const name = argv._[1];
    const useJson = !!argv.json;

    const fail = (err) => {
      console.error(`Error: ${err.message}`);
      process.exitCode = 1;
    };
    const out = (obj) => {
      if (obj === undefined) return;
      if (useJson) {
        console.log(JSON.stringify(obj, null, 2));
      } else {
        console.log(obj);
      }
    };

    try {
      switch (action) {
        case 'add': {
          if (!argv.address) return fail(new Error("'mod add' requires --address <path>"));
          const ext = path.extname(argv.address).toLowerCase();
          if (ext === '.js' || ext === '.cjs' || ext === '.mjs') {
            console.warn("Warning: JS modules run without sandbox isolation (trust model). Use .json files for data-only plugins.");
          }
          const entry = manager.add(argv.address);
          out(useJson ? entry : `Module '${entry.name}' added (${entry.path}). Use 'jsql mod enable ${entry.name}' to enable.`);
          break;
        }
        case 'enable': {
          if (!name) return fail(new Error("'mod enable' requires a module name"));
          const r = manager.enable(name);
          out(useJson ? r : `Module '${name}' enabled.`);
          break;
        }
        case 'disable': {
          if (!name) return fail(new Error("'mod disable' requires a module name"));
          const r = manager.disable(name);
          out(useJson ? r : `Module '${name}' disabled.`);
          break;
        }
        case 'remove': {
          if (!name) return fail(new Error("'mod remove' requires a module name"));
          const r = manager.remove(name);
          out(useJson ? r : `Module '${name}' removed.`);
          break;
        }
        case 'list':
        case 'ls': {
          const list = manager.list();
          out(useJson ? list : printModules(list));
          break;
        }
        case undefined:
          return fail(new Error("Missing action. Usage: jsql mod <add|enable|disable|remove|list>"));
        default:
          return fail(new Error(`Unknown mod action: ${action}`));
      }
    } catch (e) {
      fail(e);
    }
  })
  .command('export', 'Export a table to JSON or CSV', (sub) => {
    sub.option('db', { type: 'string', description: 'Database file path (default ./db.json)' });
    sub.option('json', { type: 'boolean', description: 'Output metadata as JSON' });
  }, async (argv) => {
    const table = argv._[0];
    const outFile = argv._[1];
    const fail = (e) => { console.error(`Error: ${e.message}`); process.exitCode = 1; };
    try {
      if (!table || !outFile) throw new Error('Usage: jsql export <table> <file.json|csv> [--db <path>]');
      const db = new Database(argv.db || './db.json', { autoSave: false });
      await db.loadDatabase ? db.loadDatabase() : null;
      const bytes = await migrate.exportToFile(db, table, outFile);
      if (argv.json) console.log(JSON.stringify({ ok: true, table, file: outFile, bytes }));
      else console.log(`Exported '${table}' (${bytes} bytes) to ${outFile}`);
    } catch (e) { fail(e); }
  })
  .command('import', 'Import a mysqldump (.sql), JSON (.json) or CSV (.csv) file', (sub) => {
    sub.option('db', { type: 'string', description: 'Database file path (default ./db.json)' });
    sub.option('table', { type: 'string', description: 'Target table for CSV import' });
    sub.option('strict', { type: 'boolean', description: 'Abort on first import error' });
    sub.option('json', { type: 'boolean', description: 'Output metadata as JSON' });
  }, async (argv) => {
    const file = argv._[0];
    const fail = (e) => { console.error(`Error: ${e.message}`); process.exitCode = 1; };
    try {
      if (!file) throw new Error('Usage: jsql import <file.sql|.json|.csv> [--db <path>] [--table <name>]');
      const db = new Database(argv.db || './db.json', { autoSave: false });
      await db.loadDatabase ? db.loadDatabase() : null;
      const ext = path.extname(file).toLowerCase();
      let result;
      if (ext === '.sql') {
        result = await migrate.importDumpFile(db, file, { strict: !!argv.strict });
      } else if (ext === '.json') {
        const data = JSON.parse(fs.readFileSync(file, 'utf8'));
        result = await migrate.importFromJSON(db, data);
      } else if (ext === '.csv') {
        if (!argv.table) throw new Error('CSV import requires --table <name>');
        const schemaFile = file.replace(/\.csv$/i, '.schema.json');
        const schema = fs.existsSync(schemaFile) ? JSON.parse(fs.readFileSync(schemaFile, 'utf8')) : null;
        result = await migrate.importFromCSV(db, argv.table, fs.readFileSync(file, 'utf8'), { schema });
      } else {
        throw new Error('Unsupported file type: ' + ext);
      }
      if (argv.json) {
        console.log(JSON.stringify({ ok: true, ...result }));
      } else {
        const errs = result.errors && result.errors.length;
        console.log(`Imported: ${result.created ? result.created.length + ' table(s), ' : ''}${result.inserted || 0} row(s)` + (errs ? `, ${errs} error(s)` : ''));
      }
    } catch (e) { fail(e); }
  })
  .command('serve', 'Run the MySQL-compatible server in the foreground', (sub) => {
    sub.option('port', { alias: ['p'], type: 'number', description: 'Listen port (default 3306)' });
    sub.option('host', { type: 'string', description: 'Listen host (default 127.0.0.1)' });
    sub.option('data-dir', { type: 'string', description: 'Directory to store databases' });
    sub.option('no-auth', { type: 'boolean', description: 'Allow connections without authentication' });
    sub.option('log', { type: 'boolean', description: 'Log queries to stdout' });
  }, async (argv) => {
    const { createMysqlServer } = require('../lib/mysql_server');
    const options = {
      port: argv.port != null ? argv.port : 3306,
      host: argv.host || '127.0.0.1',
      dataDir: argv['data-dir'],
      noAuth: argv['no-auth'] === true,
    };
    if (argv.log) options.onQuery = (q) => console.log('[sql]', q);
    const srv = createMysqlServer(options);
    srv.listen();
    console.log(`jsql-neo MySQL server on ${options.host}:${options.port}${options.dataDir ? ' (data: ' + options.dataDir + ')' : ' (in-memory)'}`);
    setInterval(() => {}, 1 << 30);
  })
  .command('star', 'Confirm whether you starred this repo (opens browser once)', (sub) => {
    sub.option('reset', { type: 'boolean', description: 'Forget the saved star state and re-check' });
  }, async (argv) => {
    const sn = require('../lib/star-nag');
    if (argv.reset) sn.setStarred(false);
    const c = sn.readConfig();
    if (c.starred) {
      console.log('Already confirmed starred (config: ' + sn.configPath() + ')');
      console.log('Run with --reset to re-check.');
      return;
    }
    console.log('Opening browser to confirm your star…');
    const nonceUrl = sn.startOauthCheck();     // 打开浏览器 + 后台轮询写回 ~/.jsqlmr
    if (!process.stdout.isTTY) console.log('  ' + nonceUrl);
    console.log('After you authorize, this config is updated: ' + sn.configPath());
    console.log('Waiting for authorization (up to 3 minutes)…');
    // startOauthCheck 的定时器是 unref 的，命令必须自己前台等，否则接不到结果
    const res = sn.waitForResult(nonceUrl, 180000);
    if (res && res.starred) {
      sn.setStarred(true);
      console.log(`Confirmed: ${res.login} has starred ${res.repo}. Thanks!`);
      return;
    }
    if (res) {
      console.log(`Authorization finished, but ${res.login} has not starred ${res.repo} yet.`);
      console.log(`Star it at https://github.com/${res.repo} then run \`jsql star\` again.`);
      return;
    }
    console.log('Timed out or the link expired. Run `jsql star` again to retry.');
  })
  .command('bench', 'Insert + query benchmark against a data directory', (sub) => {
    sub.option('n', { type: 'number', description: 'Number of rows (default 10000)' });
    sub.option('data-dir', { type: 'string', description: 'Data directory (default :memory:)' });
    sub.option('json', { type: 'boolean', description: 'Output as JSON' });
  }, async (argv) => {
    const N = argv.n || 10000;
    const dataDir = argv['data-dir'] || ':memory:';
    try {
      const db = new Database(dataDir === ':memory:' ? ':memory:' : path.join(dataDir, 'bench.json'), { autoSave: false });
      await db.createTable('bench', { id: { type: 'integer', primaryKey: true, autoIncrement: true }, name: { type: 'string' }, score: { type: 'float' } });
      let t0 = Date.now();
      const batch = [];
      for (let i = 0; i < N; i++) batch.push({ name: 'user_' + i, score: Math.random() * 1000 });
      for (let i = 0; i < batch.length; i += 1000) await db.insert('bench', batch.slice(i, i + 1000));
      const insertMs = Date.now() - t0;
      t0 = Date.now();
      let hits = 0;
      for (let i = 0; i < 100; i++) hits += (await db.find('bench', { score: { $gt: 500 } }, { limit: 10 })).length;
      const queryMs = Date.now() - t0;
      const total = await db.count('bench');
      const out = { ok: true, rows: N, inserted: total, insertMs, insertPerSec: Math.round(N / (insertMs / 1000)), queryMs, queryCount: 100 };
      if (argv.json) console.log(JSON.stringify(out));
      else console.log(`Inserted ${total} rows in ${insertMs}ms (${out.insertPerSec}/s), 100 queries in ${queryMs}ms`);
    } catch (e) { console.error(`Error: ${e.message}`); process.exitCode = 1; }
  })
  .command('ui', 'Serve the built-in web management console', (sub) => {
    sub.option('port', { alias: ['p'], type: 'number', description: 'HTTP port (default 8080)' });
    sub.option('host', { type: 'string', description: 'Listen host (default 127.0.0.1)' });
    sub.option('data-dir', { type: 'string', description: 'Directory containing *.json databases (default .)' });
    sub.option('auth-token', { type: 'string', description: 'Require this Bearer token for /api/*' });
    sub.option('readonly', { type: 'boolean', description: 'Never write back to disk' });
  }, async (argv) => {
    const { WebUI } = require('../lib/web_ui');
    const ui = new WebUI({
      port: argv.port != null ? argv.port : 8080,
      host: argv.host,
      dataDir: argv['data-dir'] || '.',
      authToken: argv['auth-token'],
      readonly: argv.readonly === true,
    });
    try {
      const port = await ui.start();
      const host = argv.host || ui.host;
      console.log(`JSQL-NEO web UI on http://${host}:${port} (data: ${ui.dataDir})${ui.authToken ? ' [auth]' : ''}`);
      setInterval(() => {}, 1 << 30);
    } catch (e) { console.error(`Error: ${e.message}`); process.exitCode = 1; }
  })
  .command('tui', 'Interactive SQL terminal (zero-dependency TUI)', (sub) => {
    sub.option('data-dir', { alias: ['d'], type: 'string', description: 'Data directory (default: in-memory)' });
    sub.option('db', { type: 'string', description: 'Database name (default: default)' });
    sub.option('dialect', { alias: ['t'], type: 'string', description: 'SQL dialect: mysql|pg (default: mysql)' });
  }, (argv) => {
    const { createTUI } = require('../lib/tui');
    const tui = createTUI({
      dataDir: argv['data-dir'],
      db: argv.db || 'default',
      dialect: argv.dialect || 'mysql',
    });
    tui.run().catch((e) => { console.error(`Error: ${e.message}`); process.exit(1); });
  })
  .command('redis', 'Run the Redis-compatible server', (sub) => {
    sub.option('port', { alias: ['p'], type: 'number', description: 'Listen port (default 6379)' });
    sub.option('host', { type: 'string', description: 'Listen host (default 127.0.0.1)' });
    sub.option('data-dir', { type: 'string', description: 'Directory for data.rdb.json snapshot' });
    sub.option('auth', { type: 'string', description: 'Require this password for AUTH' });
    sub.option('log', { type: 'boolean', description: 'Log commands to stdout' });
  }, (argv) => {
    const { createRedisServer } = require('../lib/redis_server');
    const srv = createRedisServer({
      port: argv.port != null ? argv.port : 6379,
      host: argv.host || '127.0.0.1',
      dataDir: argv['data-dir'],
      password: argv.auth || null,
      onQuery: argv.log ? (c) => console.log('[redis]', c.join(' ')) : null,
    });
    srv.listen();
    console.log(`jsql-neo Redis server on ${argv.host || '127.0.0.1'}:${argv.port != null ? argv.port : 6379}${argv['data-dir'] ? ' (data: ' + argv['data-dir'] + ')' : ''}`);
    setInterval(() => {}, 1 << 30);
  })
  .command('plugin', 'Plugin registry management (list, search, install, uninstall, info)', (sub) => {
    sub.option('json', { type: 'boolean', description: 'Output as JSON' });
    sub.option('category', { type: 'string', description: 'Filter by category' });
    sub.option('limit', { type: 'number', description: 'Max results per page' });
  }, async (argv) => {
    const pluginMgr = require('../src/cli/plugin');
    const action = argv._[0];
    const arg = argv._[1];
    const useJson = !!argv.json;

    const fail = (e) => { console.error(`Error: ${e.message}`); process.exitCode = 1; };
    const out = (obj) => {
      if (obj === undefined) return;
      if (useJson) console.log(JSON.stringify(obj, null, 2));
      else console.log(obj);
    };

    try {
      switch (action) {
        case 'list':
        case 'ls': {
          const opts = {};
          if (argv.category) opts.category = argv.category;
          if (argv.limit) opts.limit = argv.limit;
          const plugins = await pluginMgr.listPlugins(opts);
          out(useJson ? plugins : pluginMgr.formatPluginList(plugins));
          break;
        }
        case 'search': {
          if (!arg) throw new Error('Usage: jsql plugin search <query>');
          const opts = {};
          if (argv.category) opts.category = argv.category;
          const data = await pluginMgr.searchPlugins(arg, opts);
          // search 返回 { results: [...], query, total } 或 [...]
          const plugins = Array.isArray(data) ? data : (data.results || []);
          if (useJson) {
            out(data);
          } else {
            if (!plugins.length) {
              console.log(`No plugins found for '${arg}'.`);
            } else {
              console.log(`Found ${plugins.length} plugin(s) for '${arg}':`);
              console.log(pluginMgr.formatPluginList(plugins.map(p => p.plugin || p)));
            }
          }
          break;
        }
        case 'install': {
          if (!arg) throw new Error('Usage: jsql plugin install <name>');
          const manifest = await pluginMgr.installPlugin(arg);
          out(useJson ? manifest : `Installed plugin '${manifest.name}' (${manifest.version})`);
          break;
        }
        case 'uninstall':
        case 'remove': {
          if (!arg) throw new Error('Usage: jsql plugin uninstall <name>');
          const r = pluginMgr.uninstallPlugin(arg);
          out(useJson ? r : `Uninstalled plugin '${r.name}'.`);
          break;
        }
        case 'info': {
          if (!arg) throw new Error('Usage: jsql plugin info <name>');
          const p = await pluginMgr.getPluginInfo(arg);
          out(useJson ? p : pluginMgr.formatPluginInfo(p));
          break;
        }
        case undefined:
          // 无子命令 → 显示已安装插件
          const installed = pluginMgr.listInstalled();
          if (useJson) {
            out(installed);
          } else {
            if (!installed.length) {
              console.log('No plugins installed.');
              console.log(`Plugin directory: ${pluginMgr.PLUGIN_DIR}`);
            } else {
              console.log(`Installed plugins (${installed.length}):`);
              installed.forEach(p => {
                console.log(`  ${p.name.padEnd(24)} ${p.version || '?'}`);
              });
            }
          }
          break;
        default:
          throw new Error(`Unknown plugin action: ${action}`);
      }
    } catch (e) {
      fail(e);
    }
  })
  .command('version', 'Show version', null, () => {
    console.log(require('../package.json').version);
  })
  .command('server', 'Run the MySQL-compatible server in background', (sub) => {
    sub.option('port', { alias: ['p'], type: 'number', description: 'Listen port (default 3306)' });
    sub.option('host', { type: 'string', description: 'Listen host (default 127.0.0.1)' });
    sub.option('data-dir', { type: 'string', description: 'Directory to store databases (default in-memory)' });
    sub.option('auth', { alias: ['a'], type: 'string', description: 'User credential: user:password[:db1,db2] (repeatable)' });
    sub.option('config', { type: 'string', description: 'Path to config file (JSON)' });
    sub.option('no-auth', { type: 'boolean', description: 'Allow connections without authentication (local dev only)' });
  }, (argv) => {
    const { serverControl } = require('./jsql-server-control');
    const action = argv._[0];
    const fail = (err) => {
      console.error(`Error: ${err.message}`);
      process.exitCode = 1;
    };
    const options = {};
    if (argv.config) options.config = argv.config;
    if (argv.port != null) options.port = argv.port;
    if (argv.host != null) options.host = argv.host;
    if (argv['data-dir'] != null) options.dataDir = argv['data-dir'];
    if (argv['no-auth'] === true) options.noAuth = true;
    const authSpecs = [];
    for (let i = 0; i < RAW_ARGV.length; i++) {
      const a = RAW_ARGV[i];
      if (a === '--auth' || a === '-a') {
        if (RAW_ARGV[i + 1]) authSpecs.push(RAW_ARGV[++i]);
      } else if (a.startsWith('--auth=')) {
        authSpecs.push(a.slice(7));
      }
    }
    if (authSpecs.length > 0) options.auth = authSpecs;

    try {
      switch (action) {
        case 'start': {
          serverControl.start(options).then(
            (msg) => console.log(msg),
            (err) => fail(err)
          );
          break;
        }
        case 'stop': {
          serverControl.stop(options).then(
            (msg) => console.log(msg),
            (err) => fail(err)
          );
          break;
        }
        case 'status': {
          serverControl.status(options).then(
            (msg) => console.log(msg),
            (err) => fail(err)
          );
          break;
        }
        case undefined:
          return fail(new Error("Missing action. Usage: jsql server <start|stop|status>"));
        default:
          return fail(new Error(`Unknown server action: ${action}`));
      }
    } catch (e) {
      fail(e);
    }
  });

cli.run(process.argv.slice(2)).catch(e => {
  console.error(`Error: ${e.message}`);
  process.exitCode = 1;
});
